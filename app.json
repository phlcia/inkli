{
  "expo": {
    "name": "inkli",
    "slug": "inkli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "com.inkli.app",
    "splash": {
      "backgroundColor": "#F5EDE1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inkli.app",
      "associatedDomains": [
        "applinks:inkliapp.com"
      ],
      "infoPlist": {
        "GIDClientID": "1095402736688-7osnai7gdf6ka6ng530ij0q83j06ju8l.apps.googleusercontent.com",
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Inkli uses your contacts to find friends who are already on the app! Contact information is never stored."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F5EDE1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.inkli.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "inkli"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "inkliapp.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1095402736688-7osnai7gdf6ka6ng530ij0q83j06ju8l"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "inkli",
          "project": "react-native"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9ed75875-385f-41e2-a97b-c163e9ebf418"
      }
    }
  }
}
